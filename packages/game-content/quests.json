      "round1": {
        "round": 1,
        "npcId": "auto_driver_01",
        "hintsEnabled": true,
        "dialogueFlow": [
          {
            "step": 1,
            "npcText": "हाँ जी भैया/दीदी, कहाँ जाना है?",
            "npcAudio": "audio/npc/auto_01_r1_s1.mp3",
            "expectedIntent": "state_destination_and_ask_fare",
            "targetConcepts": ["Hawa Mahal", "jana hai", "kitna", "kiraya"],
            "suggestedPlayerText": "मुझे हवा महल जाना है, कितना किराया होगा?",
            "transliteration": "Mujhe Hawa Mahal jana hai, kitna kiraya hoga?"
          },
          {
            "step": 2,
            "npcText": "हवा महल के सौ रुपये लगेंगे।",
            "npcAudio": "audio/npc/auto_01_r1_s2.mp3",
            "expectedIntent": "accept_fare",
            "targetConcepts": ["theek hai", "chaliye"],
            "suggestedPlayerText": "ठीक है, चलिए।",
            "transliteration": "Theek hai, chaliye."
          }
        ]
      },
      "round2": {
        "round": 2,
        "npcId": "auto_driver_01",
        "hintsEnabled": false,
        "scenarioVariation": "Driver overcharges due to heavy traffic; player must negotiate.",
        "dialogueFlow": [
          {
            "step": 1,
            "npcText": "रेलवे स्टेशन चलोगे? रास्ता बहुत जाम है, दो सौ रुपये लगेंगे।",
            "npcAudio": "audio/npc/auto_01_r2_s1.mp3",
            "expectedIntent": "reject_price_and_counter_offer",
            "targetConcepts": ["zyada", "sau", "chalogey"],
            "acceptableParaphrases": [
              "नहीं, यह बहुत ज़्यादा है। सौ रुपये में चलोगे?",
              "200 रुपये बहुत ज़्यादा हैं, 100 रुपये लोगे?"
            ]
          },
          {
            "step": 2,
            "npcText": "चलो ठीक है, डेढ़ सौ (150) में बैठो।",
            "npcAudio": "audio/npc/auto_01_r2_s2.mp3",
            "expectedIntent": "accept_counter_offer",
            "targetConcepts": ["dedh sau", "chalo"],
            "acceptableParaphrases": [
              "ठीक है, डेढ़ सौ में चलो।",
              "ठीक है, चलिए 150 में।"
            ]
          }
        ]
      }
    },
    {
