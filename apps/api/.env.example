# Required
SARVAM_API_KEY=

# Server
PORT=3001

# Real-time STT (low-latency path). Only saaras:v3-realtime and saaras:v4 are
# accepted by the realtime endpoint (verified against the live API).
SARVAM_STT_REALTIME_MODEL=saaras:v3-realtime

# REST fallback model for when the WebSocket path fails or rate-limits.
SARVAM_STT_REST_MODEL=saaras:v4

# Chat model used for intent judging (Sarvam-M series / 105B).
SARVAM_CHAT_MODEL=sarvam-105b

# Default language for STT sessions when the client does not pass one.
STT_TARGET_LANGUAGE=ta-IN

# Realtime tuning. These directly control the 2s turn budget.
STT_STREAM_TYPE=fast
STT_ENDPOINTING=vad
STT_ENCODING=linear16
STT_SAMPLE_RATE=16000
STT_SILENCE_DURATION_MS=350
STT_MIN_SPEECH_DURATION_MS=200
STT_THRESHOLD=0.3
STT_PREFIX_PADDING_MS=300